#!/usr/bin/env python3
"""Set up this checkout or connect a user to its shared installation."""

import os
import runpy
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("The installer needs Python 3.11 or newer; it installs Python 3.12 for nro.")
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
sys.dont_write_bytecode = True
root = Path(__file__).resolve().parent
script = Path(__file__).resolve()
managed_python = root / ".venv/bin/python"
if "--rehearse-upgrade" in sys.argv and sys.prefix == sys.base_prefix and managed_python.is_file():
    os.execv(str(managed_python), [str(managed_python), str(script), *sys.argv[1:]])
in_rehearsal_environment = (
    "--rehearse-upgrade" in sys.argv
    and Path(sys.prefix).resolve() == managed_python.parent.parent.resolve()
)
if not in_rehearsal_environment:
    bootstrap_dependencies = runpy.run_path(str(root / "nro/engine/bootstrap_dependencies.py"))
    bootstrap_dependencies["enter"](root, script, sys.argv[1:])
runpy.run_path(str(root / "nro/engine/bootstrap.py"), run_name="__main__")
